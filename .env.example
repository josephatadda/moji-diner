# ── Database (Neon Postgres) ────────────────────────────────────────────────
# When unset, the app runs on mock data (preview mode). Set this to enable the
# real data layer, then run: npm run db:migrate && npm run seed:restaurant
DATABASE_URL=

# ── Better Auth ─────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# App URL (e.g. http://localhost:3000 in dev)
BETTER_AUTH_URL=

# ── OAuth providers (Better Auth) ───────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
